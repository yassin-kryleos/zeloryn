{
  "name": "zeloryn",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source, local-first AI software engineering cockpit.",
  "author": {
    "name": "Zeloryn Contributors",
    "email": "yassin@kryleos.com"
  },
  "homepage": "https://github.com/yassin-kryleos/zeloryn",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/backend/electron.cjs",
  "scripts": {
    "dev": "concurrently -n \"vite,server,electron\" -c \"blue,green,magenta\" \"vite\" \"tsx src/backend/server.ts\" \"electron .\"",
    "dev:e2e": "concurrently -n \"vite,server\" -c \"blue,green\" \"vite --mode test --port 5174\" \"tsx src/backend/server.ts\"",
    "server": "tsx src/backend/server.ts",
    "build": "tsc -b && vite build && npm run build:backend",
    "build:backend": "esbuild src/backend/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-backend/server.cjs",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:packaged": "npm run build && electron-builder --dir --config.win.signAndEditExecutable=false && playwright test --config playwright.packaged.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.10",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.2",
    "tree-sitter-typescript": "^0.21.2",
    "typescript": "~6.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "nock": "^14.0.15",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
