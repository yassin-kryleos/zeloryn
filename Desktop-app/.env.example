# Zeloryn — Desktop backend environment template.
# Copy to `.env` and fill in real values. NEVER commit a real `.env` (SEC-B2).

# Local backend port
PORT=3001

# Runtime mode: development | test | production
NODE_ENV=development

# Local data locations (relative to the app dir is fine for dev/test)
KRYLEOS_DB_PATH=chat_history.json
KRYLEOS_DATA_DIR=

# Network bind host. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY if you need companion devices to reach this backend over
# LAN or via a private tunnel (Tailscale/Cloudflare Tunnel) — always pair carefully.
# KRYLEOS_BIND_HOST=127.0.0.1

# AI Provider API Keys (Bring Your Own Key — BYOK)
# Configure whichever model providers you want to use. You can also configure
# keys directly in the app UI via the CONFIG header modal.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Security boundaries
# LOCAL_SESSION_SECRET protects the backend API and WebSocket bridge from
# unauthorized local processes. Required in non-test environments -- the
# app will refuse to start without a real 32+ character value set here.
# LOCAL_SESSION_SECRET=

# Optional: override the per-install fallback encryption seed (SEC-B3).
# Leave unset in normal operation — a random per-install key is generated.
# OS_FINGERPRINT=
