# Kryleos Forge — Desktop backend environment template.
# Copy to `.env` and fill in real values. NEVER commit a real `.env` (SEC-B2).

# Local backend port
PORT=3001

# Runtime mode: development | test | production
# In production, OAuth simulation and the Stripe mock-webhook bypass are disabled.
NODE_ENV=development

# Local data locations (relative to the app dir is fine for dev/test)
KRYLEOS_DB_PATH=chat_history.json
KRYLEOS_DATA_DIR=

# SEC-B5: network bind host. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY if you need companion devices to reach this backend over
# the LAN — this exposes a command-executing server, so pair carefully.
# KRYLEOS_BIND_HOST=127.0.0.1

# Stripe billing (leave unset to use safe mock keys in dev/test).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Razorpay recurring subscriptions (India). Create monthly plans with the
# canonical INR prices, then set their plan IDs here.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_SOLO=
# RAZORPAY_PLAN_SOLO_PLUS=
# RAZORPAY_PLAN_FOUNDER=

# Optional: override the per-install fallback encryption seed (SEC-B3).
# Leave unset in normal operation — a random per-install key is generated.
# OS_FINGERPRINT=
