# Kryleos Forge — Environment Configuration Template
# Copy to `.env` or `Desktop-app/.env` and fill in real values.
# NEVER commit a real `.env` file to git.

# Local backend port (default: 3001)
PORT=3001

# Runtime mode: development | test | production
NODE_ENV=development

# Network bind host. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY if you need companion devices to reach this backend over
# LAN or via a private tunnel (Tailscale/Cloudflare Tunnel).
# KRYLEOS_BIND_HOST=127.0.0.1

# AI Provider API Keys (Bring Your Own Key — BYOK)
# You can set keys here or configure them directly in the UI via the CONFIG header modal.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Security boundaries
# LOCAL_SESSION_SECRET protects the backend API and WebSocket bridge from
# unauthorized local processes. Generated automatically if omitted.
# LOCAL_SESSION_SECRET=

# Optional: override the per-install fallback encryption seed.
# Leave unset in normal operation — a random per-install key is generated.
# OS_FINGERPRINT=
